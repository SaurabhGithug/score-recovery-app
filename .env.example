# Server-only AI credentials. Copy these names into .env.local.
# Never prefix either key with NEXT_PUBLIC_ and never commit .env.local.
DEEPSEEK_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# Production database (Supabase: Project Settings > Database > connection string).
DATABASE_URL=

# Question images can be moved to a private Supabase Storage bucket in the deployment step.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=question-assets

# Production is closed by default so strangers cannot create accounts.
REGISTRATION_MODE=closed
ENABLE_DOCUMENT_PARSER=false

# Provider used for generated teaching notes. Portal answers remain authoritative.
LLM_PROVIDER=deepseek

# ChatGPT through Codex instead of API keys (uses the signed-in ChatGPT plan; run `codex login` once).
# LLM_PROVIDER=codex
# FOLLOWUP_PROVIDER=codex
# CODEX_MODEL=            # optional; default is the account's Codex default
